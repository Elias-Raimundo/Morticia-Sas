# Copiá este archivo a .env y completá los valores. NUNCA subas el .env al repo.

# ---- Base de datos ----
# Local (docker compose): postgresql://postgres:postgres@localhost:5434/pedidos
DATABASE_URL=
DIRECT_URL=
# Opcional: certificado de Supabase (Project Settings → Database → SSL) para que además
# de cifrada, la conexión se verifique. Pegalo en una línea, con \n en los saltos.
DATABASE_CA_CERT=

# ---- Seguridad ----
# Texto largo y aleatorio. Generalo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Dominios del frontend que pueden llamar a la API, separados por coma.
# Ej: https://morticia-sas.com,https://www.morticia-sas.com
# Vacío = cualquier origen (solo para desarrollo).
CORS_ORIGINS=
PORT=3001

# ---- Servicios ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=

# ---- Opcionales ----
# Minutos que tiene el cliente para modificar un pedido confirmado
ORDER_EDIT_WINDOW_MINUTES=
# Datos de pago que ve el cliente (también se pueden cargar desde Configuración)
PAYMENT_ALIAS=
PAYMENT_HOLDER=
PAYMENT_QR_URL=
# Mensualidad: contacto que se muestra en el aviso y clave del panel /owner
BILLING_CONTACT=
BILLING_ADMIN_KEY=
